# 复制为 .env 并 source / 手动导出；所有变量都能覆盖 config.toml 中的对应项。
JEV_SENTINEL_INTERVAL_SECONDS=60
JEV_SENTINEL_COOLDOWN_SECONDS=3600
JEV_SENTINEL_GRACE_SCANS=3
JEV_SENTINEL_MAX_LINES_PER_SCAN=500

JEV_SENTINEL_CLASSIFIER_TYPE=jev
JEV_SENTINEL_CLASSIFIER_THRESHOLD=0.5
JEV_SENTINEL_CLASSIFIER_MODEL=

JEV_SENTINEL_LLM_BASE_URL=
JEV_SENTINEL_LLM_MODEL=
JEV_SENTINEL_LLM_API_KEY=

JEV_SENTINEL_NOTIFIER_TYPE=console
JEV_SENTINEL_FEISHU_WEBHOOK=
JEV_SENTINEL_FEISHU_SECRET=
